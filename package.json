{
  "name": "file-reviewer",
  "displayName": "File Reviewer with AI",
  "publisher": "RaytechSolutions",
  "description": "This extension uses OpenAI API to process the contents of a file and return an analysis/review.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "file-reviewer.reviewFile",
        "title": "File Reviewer: Review this file with AI"
      },
      {
        "command": "file-reviewer.configureApiKey",
        "title": "File Reviewer: Set OpenAI API Key"
      }
    ],
    "configuration": {
      "title": "File Reviewer with AI",
      "properties": {
        "fileReviewer.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key used for code review"
        },
        "fileReviewer.modelName": {
          "type": "string",
          "default": "gpt-4-turbo",
          "description": "The OpenAI model to use for code review"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "file-reviewer.reviewFile",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "openai": "^4.96.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/indroneelray/file-reviewer-vscode-extension"
    }
}
